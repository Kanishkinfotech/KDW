generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  customerCode       String?   @unique
  customerType       String    @default("ACCOUNT") // ACCOUNT, GUEST
  name               String
  email              String    @unique
  normalizedEmail    String?
  mobile             String?
  normalizedPhone    String?
  passwordHash       String?
  emailVerified      Boolean   @default(false)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  role               String    @default("CUSTOMER")
  profileImage       String?
  businessName       String?
  businessType       String?
  gstNumber          String?
  country            String?   @default("IN")
  state              String?
  language           String?   @default("en")
  timezone           String?   @default("Asia/Kolkata")
  status             String    @default("ACTIVE") // ACTIVE, BLOCKED, SUSPENDED, ANONYMIZED
  blockScope         String?   // NONE, LOGIN, PURCHASES, DOWNLOADS, LICENCES, MARKETING, FULL
  blockReason        String?
  fraudRisk          String?   @default("LOW") // LOW, MEDIUM, HIGH
  supportPriority    String?   @default("NORMAL") // NORMAL, HIGH, VIP
  assignedStaffId    String?
  anonymizedAt       DateTime?
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  passwordChangedAt  DateTime?
  isMerged           Boolean   @default(false)
  masterCustomerId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  roleDetails        Role?     @relation(fields: [role], references: [name])

  orders                Order[]
  purchases             Purchase[]
  supportTickets        SupportTicket[]
  supportMessages       SupportMessage[]
  auditLogs             AuditLog[]
  bundleEntitlements    BundleEntitlement[]
  componentEntitlements ComponentEntitlement[]
  bundleAuditLogs       BundleAuditLog[]
  consents              CustomerConsent[]
  customerTags          CustomerTagMapping[]
  customerNotes         CustomerNote[]
  timelineEvents        CustomerTimelineEvent[]
  customerAuditLogs     CustomerAuditLog[]
  dataRequests          CustomerDataRequest[]
  abandonedCheckouts    AbandonedCheckout[]
  payments              Payment[]
  reviews               Review[]
  couponRedemptions     CouponRedemption[]
  campaignRecipients    CampaignRecipient[]
  suppressions          SuppressionEntry[]
  couponAbuseLogs       CouponAbuseLog[]

  @@index([customerCode])
  @@index([customerType])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@index([status])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
}

model Category {
  id                  String    @id @default(uuid())
  categoryCode        String?   @unique
  name                String
  slug                String    @unique
  description         String?
  shortDescription    String?
  internalNote        String?
  image               String?
  icon                String?
  banner              String?
  bannerConfig        Json?
  buyingGuide         String?
  faqs                Json?
  ctaText             String?
  attributeConfig     Json?
  displayOrder        Int       @default(0)
  status              String    @default("ACTIVE")
  featured            Boolean   @default(false)
  featuredPlacement   String?
  featuredPriority    Int?      @default(0)
  featuredStartDate   DateTime?
  featuredEndDate     DateTime?
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  canonicalUrl        String?
  ogImage             String?
  noindex             Boolean   @default(false)
  includeInSitemap    Boolean   @default(true)
  ownerAdminId        String?
  publishedAt         DateTime?
  publishScheduledAt  DateTime?
  archivedAt          DateTime?
  qualityScore        Int?      @default(0)
  parentId            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[] @relation("CategoryHierarchy")
  products     Product[]
  bundles      Bundle[]
}

model Product {
  id                  String    @id @default(uuid())
  productCode         String?
  categoryId          String
  subcategory         String?
  name                String
  slug                String    @unique
  productType         String?   @default("DOWNLOADABLE_FILE")
  description         String
  shortDescription    String?
  brand               String?
  price               Float
  discountPrice       Float?
  compareAtPrice      Float?
  costPrice           Float?
  taxMode             String?   @default("INCLUSIVE")
  taxRate             Float?    @default(18.0)
  offerStartAt        DateTime?
  offerEndAt          DateTime?
  publishScheduledAt  DateTime?
  publishedAt         DateTime?
  archivedAt          DateTime?
  googleDriveFileId   String?
  googleDriveLinks    Json?
  driveLinksCount     Int       @default(1)
  driveFileName       String?
  driveMimeType       String?
  driveFileSize       String?
  driveParentId       String?
  driveAccessStatus   String?   @default("CONNECTED")
  driveLastVerifiedAt DateTime?
  downloadLimit       Int?      @default(5)
  accessDurationDays  Int?      @default(365)
  tokenDurationMinutes Int?     @default(60)
  refundPolicy        String?   @default("REVOKE_ACCESS")
  licenceType         String?   @default("COMMERCIAL")
  licenceTerms        String?
  licenceKeyRequired  Boolean   @default(false)
  activationLimit     Int?      @default(1)
  domainLimit         Int?      @default(1)
  deviceLimit         Int?      @default(1)
  storefrontContent   Json?
  requirements        Json?
  faqs                Json?
  attributes          Json?
  versionsList        Json?
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String?
  canonicalUrl        String?
  ogImage             String?
  createdBy           String?
  updatedBy           String?
  thumbnail           String?
  previewImages       String?
  version             String?
  features            String?
  fileSize            String?
  tags                String?
  sku                 String?
  stock               Int?
  minStock            Int       @default(0)
  status              String    @default("ACTIVE")
  featured            Boolean   @default(false)
  bestSeller          Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  category              Category              @relation(fields: [categoryId], references: [id])
  orderItems            OrderItem[]
  purchases             Purchase[]
  reviews               Review[]
  reviewRequests        ReviewRequest[]
  bundles               Bundle[]
  bundleItems           BundleItem[]
  digitalDeliveries     DigitalDelivery[]
  deliveryItems         DigitalDeliveryItem[]
  componentEntitlements ComponentEntitlement[]
}

model Order {
  id                    String        @id @default(uuid())
  orderNumber           String        @unique
  customerId            String?
  guestName             String?
  guestEmail            String?
  guestMobile           String?
  customerType          String        @default("ACCOUNT") // ACCOUNT, GUEST
  totalAmount           Float
  subtotal              Float?        @default(0)
  discountTotal         Float?        @default(0)
  taxTotal              Float?        @default(0)
  refundedAmount        Float?        @default(0)
  currency              String        @default("INR")
  
  // Independent State Machine
  orderStatus           String        @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAYMENT_REVIEW, PAID, FULFILMENT_PROCESSING, FULFILLED, FAILED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED, DISPUTED, ACCESS_REVOKED
  paymentStatus         String        @default("PENDING") // PENDING, AUTHORIZED, CAPTURED, FAILED, PARTIALLY_REFUNDED, REFUNDED, DISPUTED
  accessStatus          String        @default("NOT_GRANTED") // NOT_GRANTED, PENDING, ACTIVE, PARTIALLY_DOWNLOADED, DOWNLOADED, EXPIRED, REVOKED
  fulfilmentStatus      String        @default("UNFULFILLED") // UNFULFILLED, PROCESSING, FULFILLED, FAILED, RETRYING
  refundStatus          String        @default("NONE") // NONE, REQUESTED, UNDER_REVIEW, APPROVED, PROCESSING, COMPLETED, FAILED, REJECTED, PARTIALLY_REFUNDED
  licenceStatus         String        @default("NOT_REQUIRED") // NOT_REQUIRED, NOT_ISSUED, ISSUED, ACTIVE, EXPIRED, SUSPENDED, REVOKED
  disputeStatus         String        @default("NONE") // NONE, RECEIVED, EVIDENCE_PENDING, EVIDENCE_SUBMITTED, WON, LOST, CLOSED

  razorpayOrderId       String?
  razorpayPaymentId     String?
  razorpaySignature     String?
  
  priority              String        @default("NORMAL") // NORMAL, HIGH, CRITICAL
  isHighValue           Boolean       @default(false)

  fulfilmentRetryCount  Int           @default(0)
  lastFulfilmentAttemptAt DateTime?
  fulfilmentFailureReason String?

  emailDeliveryStatus   String        @default("PENDING")
  emailSentAt           DateTime?
  emailDeliveryAttempts Int           @default(0)
  emailLastError        String?

  claimedAccountId      String?
  claimedAt             DateTime?

  createdAt             DateTime      @default(now())
  paidAt                DateTime?
  fulfilledAt           DateTime?
  cancelledAt           DateTime?
  refundedAt            DateTime?
  disputedAt            DateTime?
  updatedAt             DateTime      @default(now()) @updatedAt

  customer              User?                  @relation(fields: [customerId], references: [id])
  items                 OrderItem[]
  payments              Payment[]
  refunds               Refund[]
  disputes              Dispute[]
  orderNotes            OrderNote[]
  timelineEvents        OrderTimelineEvent[]
  auditLogs             OrderAuditLog[]
  licenceKeys           LicenceKey[]
  downloadHistory       DownloadHistory[]
  purchases             Purchase[]
  supportTickets        SupportTicket[]
  digitalDeliveries     DigitalDelivery[]
  bundleEntitlements    BundleEntitlement[]
  componentEntitlements ComponentEntitlement[]
  reviews               Review[]
  couponRedemptions     CouponRedemption[]
  reviewRequests        ReviewRequest[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([guestEmail])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([accessStatus])
  @@index([fulfilmentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                     String                 @id @default(uuid())
  orderId                String
  productId              String?
  bundleId               String?
  parentOrderItemId      String?
  productName            String
  productNameSnapshot    String?
  productTypeSnapshot    String?                @default("DIGITAL_PRODUCT")
  productVersionSnapshot String?                @default("1.0.0")
  licenceSnapshot        String?                @default("COMMERCIAL")
  accessPolicySnapshot   String?                @default("LIFETIME")
  quantity               Int                    @default(1)
  unitPrice              Float
  discountAmount         Float?                 @default(0)
  taxAmount              Float?                 @default(0)
  totalAmount            Float?                 @default(0)
  refundedAmount         Float?                 @default(0)

  order                  Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                Product?               @relation(fields: [productId], references: [id])
  bundle                 Bundle?                @relation(fields: [bundleId], references: [id])
  bundleEntitlements     BundleEntitlement[]
  componentEntitlements  ComponentEntitlement[]
  licenceKeys            LicenceKey[]
}

model Payment {
  id                    String                 @id @default(uuid())
  orderId               String
  customerId            String?
  razorpayOrderId       String?
  razorpayPaymentId     String?                @unique
  amount                Float
  currency              String                 @default("INR")
  method                String?                @default("RAZORPAY") // UPI, CARD, NETBANKING, WALLET, RAZORPAY
  status                String                 @default("PENDING") // PENDING, AUTHORIZED, CAPTURED, FAILED, CANCELLED, PARTIALLY_REFUNDED, REFUNDED, DISPUTED
  verificationStatus    String                 @default("NOT_VERIFIED") // NOT_VERIFIED, SIGNATURE_VERIFIED, WEBHOOK_VERIFIED, FULLY_VERIFIED, VERIFICATION_FAILED
  fulfilmentStatus      String                 @default("NOT_STARTED") // NOT_STARTED, PROCESSING, COMPLETED, FAILED, PARTIALLY_COMPLETED
  refundStatus          String                 @default("NOT_REFUNDED") // NOT_REFUNDED, REFUND_REQUESTED, REFUND_PENDING, PARTIALLY_REFUNDED, REFUNDED, REFUND_FAILED
  disputeStatus         String                 @default("NONE") // NONE, CREATED, UNDER_REVIEW, EVIDENCE_PENDING, EVIDENCE_SUBMITTED, WON, LOST, CLOSED
  reconciliationStatus  String                 @default("UNRECONCILED") // UNRECONCILED, MATCHED, AMOUNT_MISMATCH, CURRENCY_MISMATCH, SETTLEMENT_PENDING, RESOLVED
  signatureVerified     Boolean                @default(false)
  signatureVerifiedAt   DateTime?
  webhookVerified       Boolean                @default(false)
  webhookVerifiedAt     DateTime?
  capturedAt            DateTime?
  failedAt              DateTime?
  failureCode           String?
  failureCategory       String?                // BANK_DECLINE, INSUFFICIENT_FUNDS, AUTH_FAILURE, CUSTOMER_ABANDONED, TIMEOUT, TECHNICAL_ERROR, OTHER
  failureDescription    String?
  refundedAmount        Float                  @default(0)
  riskScore             String?                @default("NORMAL") // NORMAL, REVIEW, HIGH_RISK, BLOCKED, CLEARED
  riskReason            String?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt

  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer              User?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  refunds               Refund[]
  disputes              Dispute[]
  events                PaymentEvent[]
  reconciliations       ReconciliationRecord[]

  @@index([orderId])
  @@index([customerId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@index([verificationStatus])
  @@index([fulfilmentStatus])
  @@index([refundStatus])
  @@index([disputeStatus])
  @@index([reconciliationStatus])
  @@index([createdAt])
}

model Refund {
  id                  String    @id @default(uuid())
  orderId             String
  paymentId           String?
  razorpayRefundId    String?   @unique
  amount              Float
  currency            String    @default("INR")
  reason              String?
  status              String    @default("COMPLETED") // REQUESTED, PENDING_APPROVAL, SUBMITTED, PROCESSING, COMPLETED, FAILED, REJECTED
  requestedBy         String?
  approvedBy          String?
  rejectedBy          String?
  rejectionReason     String?
  accessRevoked       Boolean   @default(true)
  licenceRevoked      Boolean   @default(true)
  failureReason       String?
  submittedAt         DateTime?
  completedAt         DateTime? @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  order               Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment             Payment?  @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([paymentId])
  @@index([razorpayRefundId])
  @@index([status])
}

model PaymentEvent {
  id              String    @id @default(uuid())
  externalEventId String?   @unique
  paymentId       String?
  orderId         String?
  eventType       String    // payment.captured, payment.failed, order.paid, refund.created, refund.processed, refund.failed, dispute.created, dispute.won, dispute.lost
  rawPayload      String    // Raw JSON string payload
  payloadHash     String?
  signatureValid  Boolean   @default(false)
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  status          String    @default("RECEIVED") // RECEIVED, SIGNATURE_FAILED, STORED, PROCESSING, PROCESSED, DUPLICATE, FAILED, DEAD_LETTER, REPLAYED
  retryCount      Int       @default(0)
  failureReason   String?
  replayedBy      String?
  replayedAt      DateTime?

  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([externalEventId])
  @@index([paymentId])
  @@index([orderId])
  @@index([eventType])
  @@index([status])
}

model Dispute {
  id                 String    @id @default(uuid())
  paymentId          String?
  orderId            String
  razorpayDisputeId  String?   @unique
  amount             Float
  currency           String    @default("INR")
  reason             String?
  status             String    @default("UNDER_REVIEW") // CREATED, UNDER_REVIEW, EVIDENCE_PENDING, EVIDENCE_SUBMITTED, WON, LOST, CLOSED
  deadlineAt         DateTime?
  evidenceStatus     String    @default("PENDING") // PENDING, ASSEMBLED, SUBMITTED, ACCEPTED
  evidenceData       Json?
  assignedTo         String?
  outcome            String?
  accessSuspended    Boolean   @default(false)
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  payment            Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderId])
  @@index([razorpayDisputeId])
  @@index([status])
}

model Settlement {
  id                     String    @id @default(uuid())
  razorpaySettlementId   String    @unique
  settlementDate         DateTime
  grossAmount            Float
  feeAmount              Float     @default(0)
  taxAmount              Float     @default(0)
  refundAdjustment       Float     @default(0)
  netAmount              Float
  bankReference          String?
  status                 String    @default("SETTLED") // CREATED, PENDING, SETTLED, FAILED
  capturedPaymentsCount  Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt

  @@index([razorpaySettlementId])
  @@index([status])
}

model ReconciliationRecord {
  id                   String    @id @default(uuid())
  internalRecordType   String    @default("PAYMENT") // PAYMENT, REFUND, ORDER
  internalRecordId     String
  externalRecordType   String    @default("RAZORPAY_PAYMENT")
  externalRecordId     String
  expectedAmount       Float
  actualAmount         Float
  difference           Float     @default(0)
  status               String    @default("MATCHED") // UNMATCHED, MATCHED, AMOUNT_MISMATCH, CURRENCY_MISMATCH, DUPLICATE, MISSING_GATEWAY_RECORD, MISSING_INTERNAL_RECORD, RESOLVED
  differenceReason     String?
  resolvedBy           String?
  resolvedAt           DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  payment              Payment?  @relation(fields: [internalRecordId], references: [id], onDelete: Cascade)

  @@index([internalRecordId])
  @@index([externalRecordId])
  @@index([status])
}

model GatewaySetting {
  id                      String    @id @default(uuid())
  gatewayName             String    @unique @default("RAZORPAY")
  keyId                   String?
  keySecretMasked         String?
  webhookSecretMasked     String?
  currency                String    @default("INR")
  captureMode             String    @default("AUTO") // AUTO, MANUAL
  environment             String    @default("LIVE") // TEST, LIVE
  retryPolicyMaxAttempts  Int       @default(5)
  reconciliationSchedule  String    @default("DAILY")
  notificationEmails      String?
  updatedBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  @@index([gatewayName])
}


model OrderNote {
  id          String   @id @default(uuid())
  orderId     String
  authorId    String?
  authorName  String?  @default("Admin")
  authorEmail String?  @default("admin@kdw.com")
  noteType    String   @default("INTERNAL") // INTERNAL, CUSTOMER_VISIBLE, SYSTEM
  content     String
  visibility  String   @default("PRIVATE") // PRIVATE, SHARED
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderTimelineEvent {
  id          String   @id @default(uuid())
  orderId     String
  eventType   String   // ORDER_CREATED, PAYMENT_ATTEMPTED, PAYMENT_CAPTURED, FULFILMENT_STARTED, ENTITLEMENT_GRANTED, LICENCE_ISSUED, EMAIL_SENT, DOWNLOAD_ATTEMPTED, ACCESS_EXTENDED, DOWNLOAD_RESET, ACCESS_REVOKED, REFUND_PROCESSED, DISPUTE_OPENED, NOTE_ADDED
  actorType   String   @default("SYSTEM") // SYSTEM, ADMIN, CUSTOMER, WEBHOOK
  actorName   String?
  actorEmail  String?
  status      String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, WARNING
  description String
  referenceId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventType])
}

model OrderAuditLog {
  id          String   @id @default(uuid())
  orderId     String
  actorId     String?
  actorEmail  String?
  actorRole   String?  @default("SUPER_ADMIN")
  action      String   // REFUND_CREATED, ACCESS_REVOKED, ACCESS_EXTENDED, DOWNLOAD_RESET, LICENCE_REVOKED, LICENCE_REISSUED, FULFILMENT_RETRIED, NOTE_ADDED, EXPORTED
  oldValue    Json?
  newValue    Json?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model LicenceKey {
  id              String    @id @default(uuid())
  orderId         String
  orderItemId     String?
  productId       String?
  bundleId        String?
  customerId      String?
  keyMasked       String
  keyHash         String?
  licenceType     String    @default("COMMERCIAL")
  status          String    @default("ACTIVE") // ACTIVE, EXPIRED, SUSPENDED, REVOKED
  activationLimit Int       @default(1)
  activationCount Int       @default(0)
  domainLimit     Int       @default(1)
  activeDomains   Json?
  expiresAt       DateTime?
  issuedAt        DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([orderId])
  @@index([keyMasked])
}

model DownloadHistory {
  id            String    @id @default(uuid())
  orderId       String
  productId     String?
  bundleId      String?
  customerId    String?
  downloadToken String?
  result        String    @default("SUCCESS") // SUCCESS, FAILED
  failureReason String?
  ipAddress     String?
  userAgent     String?
  downloadedAt  DateTime  @default(now())

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Purchase {
  id            String   @id @default(uuid())
  customerId    String
  productId     String?
  bundleId      String?
  orderId       String?
  accessStatus  String   @default("ACTIVE")
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  customer     User          @relation(fields: [customerId], references: [id])
  product      Product?      @relation(fields: [productId], references: [id])
  bundle       Bundle?       @relation(fields: [bundleId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  accessTokens AccessToken[]
}

model AccessToken {
  id          String    @id @default(uuid())
  purchaseId  String
  secureToken String    @unique
  expiresAt   DateTime
  lastUsedAt  DateTime?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model HeroBanner {
  id         String  @id @default(uuid())
  title      String
  subtitle   String?
  image      String
  buttonText String?
  buttonUrl  String?
  status     String  @default("ACTIVE")
  sortOrder  Int     @default(0)
}

model Testimonial {
  id           String  @id @default(uuid())
  customerName String
  company      String?
  designation  String?
  image        String?
  review       String
  rating       Int     @default(5)
  status       String  @default("ACTIVE")
}

model FAQ {
  id        String @id @default(uuid())
  question  String
  answer    String
  category  String?
  sortOrder Int    @default(0)
  status    String @default("ACTIVE")
}

model Blog {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  coverImage    String
  content       String
  author        String
  publishedDate DateTime @default(now())
  status        String   @default("ACTIVE")
}

model Coupon {
  id                      String              @id @default(uuid())
  code                    String              @unique
  internalName            String?
  description             String?
  discountType            String              // PERCENTAGE, FIXED, PRODUCT_SPECIFIC, CATEGORY_SPECIFIC, BUNDLE_SPECIFIC, FIRST_ORDER, CUSTOMER_SEGMENT, AFFILIATE, FREE_PRODUCT
  discountValue           Float
  maxDiscountAmount       Float?
  currency                String              @default("INR")
  minOrderValue           Float?              @default(0)
  eligibleProducts        String?             // JSON string or comma-separated product IDs
  excludedProducts        String?
  eligibleCategories      String?
  eligibleCustomerSegments String?
  eligibleBundles         String?
  freeProductId           String?
  freeProductEntitlementMode String?          @default("LIFETIME_ACCESS")
  affiliateId             String?
  referralSource          String?
  commissionRate          Float?
  startAt                 DateTime?
  endAt                   DateTime?
  totalUsageLimit         Int?
  usedCount               Int                 @default(0)
