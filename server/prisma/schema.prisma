model CustomerConsentRecord {
  id            String    @id @default(uuid())
  customerId    String?
  customerEmail String
  purpose       String    // TRANSACTIONAL_EMAIL, MARKETING_EMAIL, WHATSAPP_MARKETING, PRODUCT_UPDATES, REVIEW_REQUESTS, ANALYTICS, COOKIES
  status        String    @default("GRANTED") // GRANTED, REVOKED
