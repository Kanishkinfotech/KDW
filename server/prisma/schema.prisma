  signatureValid   Boolean   @default(true)
  status           String    @default("PROCESSED") // RECEIVED, SIGNATURE_FAILED, PROCESSING, PROCESSED, DUPLICATE, FAILED, RETRYING, DEAD_LETTER, REPLAYED
  retryCount       Int       @default(0)
  maxRetries       Int       @default(3)
  payloadJson      Json?
  responseBody     String?
  errorMessage     String?
  relatedOrderId   String?
  relatedPaymentId String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

model SystemBackgroundJob {
  id                String    @id @default(uuid())
  jobType           String    // FULFILMENT, EMAIL_DELIVERY, WHATSAPP_DELIVERY, REFUND_PROCESSING, REPORT_GENERATION, BACKUP_VERIFICATION, DRIVE_HEALTH_CHECK, REVIEW_MODERATION, CUSTOMER_EXPORT, DATA_CLEANUP
  queue             String    @default("DEFAULT") // DEFAULT, HIGH_PRIORITY, BULK, MAINTENANCE
  status            String    @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, RETRYING, DEAD_LETTER, CANCELLED
  payloadJson       Json?
  resultJson        Json?
  errorMessage      String?
  stackTrace        String?
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  relatedResourceId String?
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  createdById       String?
  createdByName     String?   @default("System Worker")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([queue])
  @@index([status])
  @@index([jobType])
  @@index([createdAt])
}

model SystemBackup {
  id                 String    @id @default(uuid())
  backupType         String    // FULL_DATABASE, CONFIGURATION, DRIVE_FILE_MAPPING, AUDIT_ARCHIVE
  storagePath        String
  filename           String
  sizeBytes          BigInt    @default(0)
  checksumSha256     String
  encryptionStatus   String    @default("ENCRYPTED") // ENCRYPTED, PLAINTEXT
  status             String    @default("COMPLETED") // PENDING, IN_PROGRESS, COMPLETED, FAILED, VERIFIED
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED, PASSED, FAILED
  verificationNotes  String?
  recordsCount       Int       @default(0)
  retentionUntil     DateTime?
  isAutomatic        Boolean   @default(false)
  createdById        String?
  createdByName      String?   @default("System Backup Engine")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  restoreTests       SystemRestoreTest[]

  @@index([backupType])
  @@index([status])
  @@index([verificationStatus])
  @@index([createdAt])
}

model SystemRestoreTest {
  id                     String        @id @default(uuid())
  backupId               String
  environment            String        @default("SANDBOX_TEST") // SANDBOX_TEST, DRY_RUN
  status                 String        @default("PASSED") // IN_PROGRESS, PASSED, FAILED, WARNING
  restoreDurationSeconds Float         @default(0.0)
  tablesValidated        Int           @default(0)
  recordsCountValidated  Int           @default(0)
  sampleOrderVerified    Boolean       @default(true)
  sampleProductVerified  Boolean       @default(true)
  rpoResultMinutes       Float         @default(0.0)
  rtoResultSeconds       Float         @default(0.0)
  issuesReport           String?
  performedById          String?
  performedByName        String?       @default("System Automated Tester")
  startedAt              DateTime      @default(now())
  completedAt            DateTime?

  backup                 SystemBackup  @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@index([status])
  @@index([startedAt])
}

model SystemIncident {
  id                    String    @id @default(uuid())
  incidentNumber        String    @unique // e.g. INC-2026-001
  title                 String
  severity              String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  service               String    // API, DATABASE, RAZORPAY, EMAIL, GOOGLE_DRIVE, STORAGE, AUTH, WORKERS
  status                String    @default("ACTIVE") // ACTIVE, INVESTIGATING, MITIGATED, RESOLVED, POSTMORTEM
  affectedCustomersCount Int       @default(0)
  summary               String?
  rootCause             String?
  actionsTaken          String?
  postmortemReport      String?
  ownerId               String?
  ownerName             String?   @default("Unassigned")
  startedAt             DateTime  @default(now())
  detectedAt            DateTime  @default(now())
  mitigatedAt           DateTime?
  resolvedAt            DateTime?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([service])
  @@index([createdAt])
}

model SystemMonitoringAlert {
  id                 String    @id @default(uuid())
  alertType          String    // API_ERROR_SPIKE, LATENCY_BREACH, DATABASE_CONN_SPIKE, WEBHOOK_DELAY, QUEUE_BACKLOG, DOWNLOAD_FAILURE_SPIKE, BACKUP_OVERDUE, DISK_SPACE_WARNING, SUSPICIOUS_LOGINS, FAILED_TRANSACTIONS
  severity           String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  source             String    // API, DATABASE, RAZORPAY, DRIVE, WORKER, BACKUP, AUTH
  status             String    @default("OPEN") // OPEN, ACKNOWLEDGED, INVESTIGATING, SNOOZED, RESOLVED
  title              String
  message            String
  metricValue        String?
  thresholdValue     String?
  occurrenceCount    Int       @default(1)
  firstDetectedAt    DateTime  @default(now())
  lastDetectedAt     DateTime  @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  ownerId            String?
  ownerName          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([source])
  @@index([lastDetectedAt])
}

model SystemThresholdRule {
  id                 String    @id @default(uuid())
  metricKey          String    @unique // e.g. api_5xx_rate, api_p95_latency, queue_oldest_job_mins, download_failure_rate, db_conn_percent, backup_age_hours
  metricName         String
  category           String    // API, DATABASE, QUEUE, DOWNLOAD, PAYMENT, BACKUP
  warningThreshold   Float
  criticalThreshold  Float
  unit               String    // %, ms, min, hours
  comparisonOperator String    @default("GREATER_THAN") // GREATER_THAN, LESS_THAN
  isEnabled          Boolean   @default(true)
  updatedByName      String?   @default("System")
  updatedAt          DateTime  @updatedAt

  @@index([category])
  @@index([metricKey])
}

// ==========================================
// CACHE MANAGEMENT & TEMPORARY DATA STORE
// ==========================================

model CacheEntry {
  id              String    @id @default(uuid())
  key             String    @unique
  namespace       String    // e.g. kdw:prod:product, kdw:prod:category, kdw:prod:search
  environment     String    @default("PRODUCTION") // PRODUCTION, STAGING, TEST
  valueType       String    @default("JSON") // JSON, STRING, NUMBER, BUFFER
  sizeBytes       Int       @default(0)
  ttlSeconds      Int       @default(600)
  expiresAt       DateTime
  isRebuildable   Boolean   @default(true)
  sourceOfTruth   String    @default("PostgreSQL")
  hitCount        Int       @default(0)
  missCount       Int       @default(0)
  lastAccessedAt  DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([namespace])
  @@index([environment])
  @@index([expiresAt])
}

model CacheNamespaceConfig {
  id                    String    @id @default(uuid())
  namespace             String    @unique // e.g. kdw:prod:product
  environment           String    @default("PRODUCTION")
  defaultTtlSeconds     Int       @default(600)
  maxStalenessSeconds   Int       @default(600)
  rebuildSource         String    @default("PostgreSQL:Product")
  invalidationTriggers  String    // JSON array of event names
  status                String    @default("ACTIVE") // ACTIVE, PAUSED, WARMING
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([namespace])
  @@index([environment])
}

model CacheInvalidationEvent {
  id                String    @id @default(uuid())
  eventType         String    // PRODUCT_UPDATED, CATEGORY_UPDATED, PRICE_CHANGED, PROMO_EXPIRED
  namespace         String
  keyPattern        String
  triggerSource     String    @default("PostgreSQL_TRIGGER")
  affectedEntityId  String?
  status            String    @default("COMPLETED") // COMPLETED, FAILED, PENDING, RETRYING
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  failureReason     String?
  createdAt         DateTime  @default(now())
  processedAt       DateTime?

  @@index([namespace])
  @@index([status])
  @@index([createdAt])
}

model CacheMaintenanceLog {
  id            String    @id @default(uuid())
  action        String    // CLEAR_ALL, CLEAR_NAMESPACE, CLEAR_KEY, REBUILD, WARM, EXPIRED_CLEANUP, MEMORY_CLEANUP, QUEUE_CLEANUP
  actorId       String?
  actorName     String?   @default("Administrator")
  actorRole     String?   @default("SUPER_ADMIN")
  namespace     String?
  keysAffected  Int       @default(0)
  reason        String?
  durationMs    Int       @default(0)
  result        String    @default("SUCCESS") // SUCCESS, FAILED, PARTIAL
  createdAt     DateTime  @default(now())

  @@index([action])
  @@index([createdAt])
}

// ==========================================
// ADMIN USERS, STAFF, ROLES & GOVERNANCE
// ==========================================

model StaffProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  department         String    @default("MANAGEMENT") // MANAGEMENT, CATALOG, FINANCE, SUPPORT, MARKETING, CONTENT, SECURITY, ENGINEERING
  team               String    @default("CORE") // CORE, SUPPORT_TIER_1, SUPPORT_TIER_2, FINANCE_OPS, GROWTH
  managerId          String?
  timezone           String    @default("Asia/Kolkata")
  phone              String?
  employeeReference  String?   @unique
  mfaEnabled         Boolean   @default(false)
  mfaSecretMasked    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([team])
}

model SystemPermission {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. product.read, product.publish, refund.approve, customer.export
  resource    String    // PRODUCT, ORDER, PAYMENT, REFUND, CUSTOMER, DOWNLOAD, LICENCE, CAMPAIGN, CONTENT, REVIEW, SETTINGS, CACHE, SYSTEM, ADMIN, AUDIT
  action      String    // READ, CREATE, UPDATE, PUBLISH, APPROVE, DELETE, EXPORT, MANAGE
  riskLevel   String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  description String
  createdAt   DateTime  @default(now())

  roleMappings RolePermissionMapping[]

  @@index([resource])
  @@index([riskLevel])
}

model RolePermissionMapping {
  id           String           @id @default(uuid())
  roleId       String
  permissionId String
  scopeType    String           @default("ALL") // ALL, STORE, CATEGORY, ASSIGNED_ONLY, OWN_TICKETS
  scopeValue   String?

  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   SystemPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, scopeType])
  @@index([roleId])
  @@index([permissionId])
}

model TemporaryPermissionGrant {
  id             String    @id @default(uuid())
  userId         String
  userEmail      String
  permissionCode String
  scope          String    @default("ALL")
  startsAt       DateTime  @default(now())
  expiresAt      DateTime
  reason         String
  approvedById   String?
  approvedByName String?   @default("Super Admin")
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([permissionCode])
  @@index([status])
  @@index([expiresAt])
}

model StaffInvitation {
  id            String    @id @default(uuid())
  email         String    @unique
  roleName      String    @default("Support Agent")
  department    String    @default("SUPPORT")
  team          String    @default("CORE")
  tokenHash     String    @unique
  invitedById   String?
  invitedByName String?   @default("Super Admin")
  expiresAt     DateTime
  acceptedAt    DateTime?
  status        String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  createdAt     DateTime  @default(now())

  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model AdminSession {
  id              String    @id @default(uuid())
  userId          String
  userEmail       String
  userName        String
  sessionHash     String    @unique
  ipAddress       String?
  userAgent       String?
  deviceReference String?
  mfaVerified     Boolean   @default(false)
  expiresAt       DateTime
  lastActiveAt    DateTime  @default(now())
  revokedAt       DateTime?
  isRevoked       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([userEmail])
  @@index([isRevoked])
  @@index([lastActiveAt])
}

model AccessReviewRecord {
  id                        String    @id @default(uuid())
  reviewDate                DateTime  @default(now())
  reviewerId                String?
  reviewerName              String    @default("Chief Security Auditor")
  targetUserId              String
  targetUserEmail           String
  targetUserRole            String
  sensitivePermissionsCount Int       @default(0)
  lastLoginAt               DateTime?
  recommendation            String    @default("MAINTAIN_ACCESS") // MAINTAIN_ACCESS, REDUCE_PERMISSIONS, SUSPEND_ACCOUNT, ENROLL_MFA
  actionTaken               String    @default("APPROVED_NO_CHANGE") // APPROVED_NO_CHANGE, PERMISSIONS_REDUCED, USER_SUSPENDED
  notes                     String?
  createdAt                 DateTime  @default(now())

  @@index([targetUserId])
  @@index([reviewDate])
}

model StaffActivityLog {
  id                String    @id @default(uuid())
  actorId           String?
  actorName         String    @default("Staff")
  actorEmail        String
  actorRole         String    @default("ADMIN")
  action            String    // e.g. USER_SUSPENDED, PERMISSION_GRANTED, CACHE_PURGED, ROLE_UPDATED
  resourceType      String    // CACHE, USER, ROLE, PERMISSION, SESSION, INVITATION
  resourceId        String?
  result            String    @default("SUCCESS") // SUCCESS, DENIED, FAILED, CANCELLED
  riskLevel         String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  previousValueSafe String?
  newValueSafe      String?
  reason            String?
  ipAddress         String?
  userAgent         String?
  requestId         String?
  createdAt         DateTime  @default(now())

  @@index([actorEmail])
  @@index([action])
  @@index([resourceType])
  @@index([riskLevel])
  @@index([createdAt])
}

// ==========================================
// WORKFLOW AUTOMATION & DURABLE EVENT ENGINE
// ==========================================

model AutomationRule {
  id              String           @id @default(uuid())
  name            String
  description     String?
  category        String           @default("ORDER") // ORDER, EMAIL, CUSTOMER, DOWNLOAD, LICENCE, CUSTOM
  triggerEvent    String           // e.g. order.paid, customer.email_verified, download.failed, license.issued
  conditionJson   String           @default("[]") // JSON array of condition clauses
  actionJson      String           @default("[]") // JSON array of action step definitions
  status          String           @default("ACTIVE") // ACTIVE, PAUSED, DRAFT, ARCHIVED
  version         Int              @default(1)
  executionCount  Int              @default(0)
  lastExecutedAt  DateTime?
  createdBy       String?          @default("System")
  updatedBy       String?          @default("System")
  isTemplate      Boolean          @default(false)
  templateKey     String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  runs            AutomationRun[]

  @@index([category])
  @@index([triggerEvent])
  @@index([status])
}

model AutomationRun {
  id               String                 @id @default(uuid())
  workflowId       String
  workflowName     String
  triggerEventId   String?
  triggerEventType String
  status           String                 @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, RETRYING, CANCELLED, DEAD_LETTER, REPLAYED
  customerEmail    String?
  customerId       String?
  orderId          String?
  productId        String?
  startedAt        DateTime               @default(now())
  completedAt      DateTime?
  durationMs       Int                    @default(0)
  attemptCount     Int                    @default(1)
  maxAttempts      Int                    @default(3)
  errorCode        String?
  errorMessage     String?
  isDryRun         Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  workflow         AutomationRule         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps            AutomationRunStep[]
  jobs             AutomationJob[]
  deadLetterJobs   AutomationDeadLetterJob[]

  @@index([workflowId])
  @@index([status])
  @@index([triggerEventType])
  @@index([orderId])
  @@index([customerEmail])
  @@index([createdAt])
}

model AutomationRunStep {
  id           String        @id @default(uuid())
  runId        String
  stepOrder    Int           @default(1)
  stepType     String        // TRIGGER, CONDITION, DELAY, ACTION, BRANCH
  actionType   String?       // CREATE_ENTITLEMENT, ISSUE_LICENCE, SEND_EMAIL, ADD_TAG, CREATE_TICKET, NOTIFY_ADMIN, DRIVE_HEALTH_CHECK, REVOKE_ACCESS
  status       String        @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, SKIPPED
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  durationMs   Int           @default(0)
  resultJson   String?
  errorMessage String?
  createdAt    DateTime      @default(now())

  run          AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
}

model AutomationJob {
  id           String        @id @default(uuid())
  runId        String
  queue        String        @default("DEFAULT") // HIGH_PRIORITY, DEFAULT, BULK, DELAYED, MAINTENANCE
  status       String        @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, RETRYING, DEAD_LETTER, CANCELLED
  priority     String        @default("NORMAL") // HIGH, NORMAL, LOW
  attempts     Int           @default(0)
  maxAttempts  Int           @default(3)
  nextRetryAt  DateTime?
  lockedAt     DateTime?
  completedAt  DateTime?
  payloadJson  String?
  lastError    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  run          AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([queue])
  @@index([status])
  @@index([nextRetryAt])
}

model AutomationDeadLetterJob {
  id              String        @id @default(uuid())
  jobId           String?
  runId           String
  workflowId      String
  workflowName    String
  originalEventId String?
  eventType       String
  payloadJson     String?
  failureReason   String
  attemptCount    Int           @default(3)
  firstFailedAt   DateTime      @default(now())
  lastFailedAt    DateTime      @default(now())
  replayStatus    String        @default("UNREPLAYED") // UNREPLAYED, REPLAYED, CANCELLED, RESOLVED
  replayedBy      String?
  replayedAt      DateTime?
  createdAt       DateTime      @default(now())

  run             AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([replayStatus])
  @@index([createdAt])
}

model AutomationEventRecord {
  id           String    @id @default(uuid())
  eventId      String    @unique
  eventType    String    // order.paid, order.created, customer.email_verified, download.failed, license.issued
  source       String    @default("INTERNAL_SERVICE") // ORDER_SERVICE, PAYMENT_WEBHOOK, CUSTOMER_SERVICE, DOWNLOAD_SERVICE, LICENCE_SERVICE, SUPPORT_SERVICE, SYSTEM_CRON
  resourceType String    // ORDER, PAYMENT, CUSTOMER, DOWNLOAD, LICENCE, TICKET
  resourceId   String?
  payloadJson  String?
  status       String    @default("RECEIVED") // RECEIVED, PROCESSING, PROCESSED, DUPLICATE, FAILED
  occurredAt   DateTime  @default(now())
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([eventType])
  @@index([status])
  @@index([resourceId])
  @@index([occurredAt])
}

model AutomationSchedule {
  id             String    @id @default(uuid())
  name           String
  workflowId     String
  scheduleType   String    @default("RECURRING_CRON") // ONE_TIME, RECURRING_CRON, DELAYED, BUSINESS_HOURS
  cronExpression String?   // e.g. 0 * * * * or 0 9 * * 1-5
  nextExecutionAt DateTime?
  lastExecutionAt DateTime?
  status         String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workflowId])
  @@index([status])
  @@index([nextExecutionAt])
}

model AutomationWebhookEndpoint {
  id               String    @id @default(uuid())
  name             String
  url              String
  secretMasked     String?
  secretHash       String?
  direction        String    @default("OUTGOING") // INCOMING, OUTGOING
  provider         String    @default("CUSTOM") // RAZORPAY, RESEND, WHATSAPP, CUSTOM
  subscribedEvents String    @default("[]") // JSON array of event names
  status           String    @default("ACTIVE") // ACTIVE, DISABLED
  retryCount       Int       @default(0)
  failureCount     Int       @default(0)
  lastDeliveryAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider])
  @@index([status])
}

model AutomationIdempotencyKey {
  id             String    @id @default(uuid())
  idempotencyKey String    @unique // e.g. order.paid:ORD-1234:create-entitlement
  actionType     String    // CREATE_ENTITLEMENT, ISSUE_LICENCE, SEND_EMAIL, REFUND
  resourceType   String    // ORDER, CUSTOMER, PRODUCT
  resourceId     String
  status         String    @default("COMPLETED") // PENDING, COMPLETED, FAILED
  responseJson   String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([idempotencyKey])
  @@index([expiresAt])
}






