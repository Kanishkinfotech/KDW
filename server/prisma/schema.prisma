  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  parentEntitlement   BundleEntitlement @relation(fields: [parentEntitlementId], references: [id], onDelete: Cascade)
  bundle              Bundle            @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer            User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem           OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([parentEntitlementId])
  @@index([bundleId])
  @@index([productId])
  @@index([customerId])
}

model BundleAuditLog {
  id            String   @id @default(uuid())
  bundleId      String
  actorId       String?
  actorEmail    String?
  action        String   // CREATED, UPDATED, VERSION_PUBLISHED, PRICING_CHANGED, COMPONENT_ADDED, COMPONENT_REMOVED, LINK_RESENT, DOWNLOAD_RESET, ACCESS_REVOKED
  previousState Json?
  newState      Json?
  reason        String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  bundle        Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bundleId])
}

model CustomerConsent {
  id                 String    @id @default(uuid())
  customerId         String
  consentType        String    // TRANSACTIONAL_EMAIL, MARKETING_EMAIL, WHATSAPP_MARKETING, PRODUCT_UPDATES, REVIEW_REQUESTS, ANALYTICS_COOKIES, PERSONALIZATION, SMS_COMMUNICATION
  status             String    @default("OPTED_IN") // NOT_REQUESTED, OPTED_IN, OPTED_OUT, WITHDRAWN, SUPPRESSED, INVALID
  source             String?   @default("CHECKOUT") // CHECKOUT, REGISTRATION, PROFILE, PREFERENCES, BANNER
  consentTextVersion String?   @default("1.0")
  method             String?   @default("EXPLICIT_CHECKBOX")
  ipAddress          String?
  userAgent          String?
  withdrawnAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  customer           User      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([consentType])
  @@index([status])
}

model CustomerTag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?  @default("indigo")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  mappings    CustomerTagMapping[]

  @@index([name])
}

model CustomerTagMapping {
  id           String   @id @default(uuid())
  customerId   String
  tagId        String
  assignedBy   String?  @default("Admin")
  assignedById String?
  reason       String?
  createdAt    DateTime @default(now())

  customer     User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag          CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
}

model CustomerSegment {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  description        String?
  type               String    @default("DYNAMIC") // DYNAMIC, STATIC
  conditions         Json      // Query criteria
  staticCustomerIds  Json?
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE
  owner              String?   @default("Admin")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([slug])
}

model CustomerNote {
  id          String   @id @default(uuid())
  customerId  String
  authorId    String?
  authorName  String?  @default("Admin")
  authorEmail String?
  noteType    String   @default("INTERNAL") // INTERNAL, SUPPORT, BILLING, COMPLIANCE
  content     String
  createdAt   DateTime @default(now())

  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerTimelineEvent {
  id          String   @id @default(uuid())
  customerId  String
  eventType   String   // CUSTOMER_CREATED, EMAIL_VERIFIED, ORDER_CREATED, PAYMENT_COMPLETED, ENTITLEMENT_CREATED, ACCESS_DELIVERED, DOWNLOAD_SUCCESS, DOWNLOAD_FAILED, LICENCE_ACTIVATED, LICENCE_EXTENDED, LICENCE_RESET, REFUND_COMPLETED, TICKET_OPENED, TICKET_RESOLVED, TAG_ADDED, TAG_REMOVED, CONSENT_GRANTED, CONSENT_WITHDRAWN, CUSTOMER_BLOCKED, CUSTOMER_UNBLOCKED, GUEST_CLAIMED, MERGED, EXPORT_GENERATED, DATA_REQUEST_PROCESSED, ANONYMIZED
  actorType   String   @default("SYSTEM") // SYSTEM, ADMIN, CUSTOMER, WEBHOOK
  actorName   String?
  actorEmail  String?
  status      String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, WARNING
  description String
  referenceId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([eventType])
}

model CustomerAuditLog {
  id          String   @id @default(uuid())
  customerId  String
  actorId     String?
  actorEmail  String?
  actorRole   String?  @default("SUPER_ADMIN")
  action      String   // EDIT, BLOCK, UNBLOCK, MERGE, EXPORT, DELETE, ANONYMIZE, TAG_CHANGE, CONSENT_CHANGE, GUEST_CLAIM, ACCESS_CHANGE
  oldValue    Json?
  newValue    Json?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  customer    User     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([action])
}

model CustomerDataRequest {
  id              String    @id @default(uuid())
  customerId      String
  requestType     String    // ACCESS, CORRECTION, DELETION, RESTRICTION, PORTABILITY, CONSENT_WITHDRAWAL, MARKETING_UNSUBSCRIBE, ACCOUNT_CLOSURE
  status          String    @default("SUBMITTED") // SUBMITTED, IN_REVIEW, PROCESSING, COMPLETED, REJECTED
  reason          String?
  requestedBy     String
  processedBy     String?
  resolutionNotes String?
  exportFileUrl   String?
  exportExpiresAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  customer        User      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([requestType])
  @@index([status])
}

model CustomerAlias {
  id               String   @id @default(uuid())
  masterCustomerId String
  mergedCustomerId String
  mergedEmail      String
  mergedPhone      String?
  mergedAt         DateTime @default(now())
  mergeReason      String?
  actorId          String?
  actorEmail       String?

  @@index([masterCustomerId])
  @@index([mergedCustomerId])
  @@index([mergedEmail])
}

model AbandonedCheckout {
  id                  String    @id @default(uuid())
  customerId          String?
  customerEmail       String
  customerName        String?
  customerPhone       String?
  cartData            Json
  totalAmount         Float
  status              String    @default("ABANDONED") // ABANDONED, RECOVERED, EXPIRED
  recoveryEmailSent   Boolean   @default(false)
  recoveryEmailSentAt DateTime?
  recoveredAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  customer            User?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerEmail])
  @@index([status])
}

