  channel       String    @default("WEB") // WEB, CHECKOUT, ACCOUNT, EMAIL
  source        String?
  ipAddress     String?
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([customerEmail, purpose])
  @@index([status])
}

model DataRetentionRule {
  id                 String    @id @default(uuid())
  entityType         String    @unique // CUSTOMER_PROFILE, LOGIN_LOG, DOWNLOAD_LOG, SUPPORT_TICKET, MARKETING_CONSENT, PAYMENT_RECORD, AUDIT_LOG, EXPORT_FILE
