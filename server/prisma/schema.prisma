  @@index([email])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model ReportAlert {
  id                 String    @id @default(uuid())
  category           String    // CUSTOMER, LOGIN, BUY_ANALYSIS, COUPON, DOWNLOAD
  alertType          String    // unresolved_download_failure, access_after_refund, unclaimed_guest_order, repeated_login_failures, multiple_accounts_one_ip, suspicious_claim, coupon_budget_exceeded, coupon_abuse_pattern, coupon_high_refund_rate, paid_without_entitlement, drive_permission_error, drive_file_missing, version_failure_spike
  severity           String    @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  status             String    @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED, DISMISSED
  title              String
  description        String
  affectedEntityId   String?
  affectedEntityType String?  // User, Order, Product, Coupon, DownloadToken
  metadata           Json?
  createdAt          DateTime  @default(now())
