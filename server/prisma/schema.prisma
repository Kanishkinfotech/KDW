  updatedAt          DateTime  @updatedAt

  @@index([entityType])
}

// ==========================================
// SYSTEM MANAGEMENT & INFRASTRUCTURE MONITORING
// ==========================================

model SystemErrorLog {
  id              String    @id @default(uuid())
  errorCode       String    @default("INTERNAL_SERVER_ERROR") // e.g. DRIVE_PERMISSION_DENIED, DB_ERROR, INTERNAL_SERVER_ERROR
  severity        String    @default("ERROR") // DEBUG, INFO, WARNING, ERROR, CRITICAL, SECURITY
  service         String    @default("API") // API, DATABASE, PAYMENT, WEBHOOK, DOWNLOAD, EMAIL, WORKER, STORAGE, AUTH
  environment     String    @default("PRODUCTION") // PRODUCTION, DEVELOPMENT, TEST
  requestId       String?
  traceId         String?
  actorId         String?
  actorName       String?
  userId          String?
  customerId      String?
  customerEmail   String?
  orderId         String?
  productId       String?
  message         String
  stackTrace      String?
  stack           String?
  method          String?   @default("GET")
  path            String?
  endpoint        String?
  statusCode      Int?      @default(500)
  ip              String?
  userAgent       String?
  metadata        String?
  status          String    @default("OPEN") // OPEN, UNRESOLVED, ACKNOWLEDGED, INVESTIGATING, RESOLVED, SUPPRESSED
  assignedOwner   String?
  assignedOwnerId String?
  resolvedById    String?
  occurrenceCount Int       @default(1)
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([service])
  @@index([severity])
  @@index([status])
  @@index([method])
  @@index([statusCode])
  @@index([errorCode])
  @@index([createdAt])
  @@index([lastSeenAt])
}

model SystemLoginLog {
  id               String    @id @default(uuid())
  userType         String    @default("CUSTOMER") // ADMIN, STAFF, CUSTOMER
  userId           String?
  email            String
  userName         String?
  eventType        String    // LOGIN_SUCCESS, LOGIN_FAILURE, LOGOUT, SESSION_REVOKED, PASSWORD_RESET, MFA_CHALLENGE, MFA_FAILED, ACCOUNT_LOCKED
  result           String    @default("SUCCESS") // SUCCESS, FAILED, BLOCKED
  failureReason    String?
  ipAddress        String?
  userAgent        String?
  deviceHash       String?
  sessionHash      String?
  isSuspicious     Boolean   @default(false)
  suspiciousReason String?
  createdAt        DateTime  @default(now())

  @@index([userType])
  @@index([email])
  @@index([eventType])
  @@index([result])
  @@index([isSuspicious])
  @@index([createdAt])
}

model SystemApiLog {
  id                String    @id @default(uuid())
  requestId         String    @unique
  method            String    // GET, POST, PUT, PATCH, DELETE
  endpoint          String
  statusCode        Int
  latencyMs         Int
  actorId           String?
  actorRole         String?
  ipAddress         String?
  userAgent         String?
  responseSizeBytes Int?      @default(0)
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime  @default(now())

  @@index([endpoint])
  @@index([statusCode])
  @@index([createdAt])
  @@index([latencyMs])
}

model SystemWebhookLog {
  id               String    @id @default(uuid())
  provider         String    // RAZORPAY, RESEND, WHATSAPP, GOOGLE_DRIVE
