  @@index([status])
}

model LegalDocumentVersion {
  id            String         @id @default(uuid())
  documentId    String
  versionNumber Int
  title         String
  content       String         // Markdown or HTML content
  summary       String?
  status        String         @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, PUBLISHED, ARCHIVED
