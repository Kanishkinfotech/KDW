model SystemSetting {
  id            String    @id @default(uuid())
  key           String    @unique
  value         String    // JSON stringified value or plain text
  group         String    // GENERAL, STORE, CURRENCY, TAX, CHECKOUT, DOWNLOAD, EMAIL, SECURITY, PRIVACY, LEGAL, INTEGRATION
  dataType      String    @default("STRING") // STRING, NUMBER, BOOLEAN, JSON, SECRET
  isSecret      Boolean   @default(false)
  scope         String    @default("GLOBAL") // GLOBAL, STOREFRONT, ADMIN
  version       Int       @default(1)
  description   String?
  updatedById   String?
  updatedByName String?   @default("System")
  changeReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([group])
  @@index([key])
  @@index([scope])
}

model SettingVersion {
  id            String    @id @default(uuid())
  settingKey    String
  group         String
  oldValue      String?
  newValue      String
  versionNumber Int
  changedById   String?
  changedByName String?   @default("Administrator")
  changeReason  String?
  environment   String    @default("PRODUCTION") // PRODUCTION, DEVELOPMENT, TEST
  createdAt     DateTime  @default(now())

  @@index([settingKey])
  @@index([group])
  @@index([createdAt])
}

model SettingAuditLog {
