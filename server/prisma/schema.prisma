  group         String
  details       String?
  ipAddress     String?
  userAgent     String?
  environment   String    @default("PRODUCTION")
  createdAt     DateTime  @default(now())

  @@index([group])
  @@index([action])
  @@index([createdAt])
}

model LegalDocument {
  id               String                 @id @default(uuid())
  slug             String                 @unique // terms-of-service, refund-policy, digital-delivery-policy, licence-policy, privacy-policy, cookie-policy, copyright-policy, support-policy
  name             String
  category         String                 @default("LEGAL") // LEGAL, POLICY, COMPLIANCE
  currentVersion   Int                    @default(1)
  publishedVersion Int?
  status           String                 @default("DRAFT") // DRAFT, IN_REVIEW, APPROVED, PUBLISHED, ARCHIVED
